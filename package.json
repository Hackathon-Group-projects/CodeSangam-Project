{
  "name": "the-vishanti-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "The Vishanti Ledger: Tamper-Evident Grievance Redressal & Cryptographic Audit Portal (CodeSangam - Problem Statement 03)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@vishanti/web",
    "dev:api": "npm run dev --workspace=@vishanti/api",
    "dev:worker": "npm run dev --workspace=@vishanti/worker",
    "test:e2e": "npm run test:e2e --workspace=@vishanti/web",
    "test:e2e:report": "npm run test:e2e:report --workspace=@vishanti/web",
    "prebuild": "npm run prisma:generate --workspace=@vishanti/db",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "report:escalation": "tsx scripts/verify-escalation-report.ts",
    "test:k6": "k6 run scripts/k6-load-test.js",
    "test:member3": "tsx scripts/test-member3.ts",
    "prisma:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma"
  },
  "keywords": [
    "grievance-redressal",
    "sha-256",
    "cryptographic-audit",
    "tamper-evident",
    "nextjs",
    "fastify",
    "bullmq"
  ],
  "author": "Team TriNity (Harsh, Kashvi, Aryan)",
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "devDependencies": {
    "ioredis": "^6.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "docker": "^1.0.0"
  }
}
