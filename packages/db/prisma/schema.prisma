generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  PETITIONER
  OFFICER_TIER_1
  COMMITTEE_TIER_2
  OMBUDSMAN_TIER_3
  AUDITOR
  ADMIN
}

enum Category {
  ACADEMIC
  HOSTEL_MESS
  FINANCIAL_FEES
  HARASSMENT_DISCIPLINARY
  INFRASTRUCTURE
  ADMINISTRATION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  FILED
  ASSIGNED
  IN_REVIEW
  RESOLVED
  ESCALATED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  role         Role     @default(PETITIONER)
  tier         Int      @default(0) // 0 for petitioner, 1 for officer, 2 for committee, 3 for ombudsman
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets Ticket[] @relation("AssignedOfficer")
  filedTickets    Ticket[] @relation("PetitionerTickets")

  @@map("users")
}

model Ticket {
  id              String      @id @default(uuid())
  title           String      @db.VarChar(120)
  description     String
  category        Category
  priority        Priority
  status          Status      @default(FILED)
  isAnonymous     Boolean     @default(false)
  receiptHash     String?     @unique @db.VarChar(64) // SHA-256 of the one-time receipt secret
  petitionerRef   String?     @db.VarChar(64) // Per-ticket HMAC pseudonym; populated for anonymous filing
  petitionerId    String?     // Set only when a signed-in petitioner files the ticket
  currentTier     Int         @default(1)
  version         Int         @default(1) // Incremented on every state change
  slaDueAt        DateTime?
  assignedToId    String?
  clusterGroupId  String?
  embedding       Unsupported("vector")? // pgvector 384-dimensional all-MiniLM-L6-v2
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignedTo      User?         @relation("AssignedOfficer", fields: [assignedToId], references: [id], onDelete: SetNull)
  petitioner      User?         @relation("PetitionerTickets", fields: [petitionerId], references: [id], onDelete: SetNull)
  clusterGroup    ClusterGroup? @relation(fields: [clusterGroupId], references: [id], onDelete: SetNull)
  auditEntries    AuditEntry[]
  attachments     Attachment[]

  @@index([status])
  @@index([category])
  @@index([slaDueAt])
  @@index([petitionerId])
  @@map("tickets")
}

model AuditEntry {
  id        String   @id @default(uuid())
  ticketId  String
  seq       Int      // Sequence number: 0, 1, 2...
  type      String   @db.VarChar(32) // CREATED, ASSIGNED, TRANSITIONED, COMMENTED, RESOLVED, DISPUTED, ESCALATED
  actorRef  String   @db.VarChar(128) // User ID or per-ticket HMAC pseudonym; intentionally not a User foreign key
  payload   Json     @db.JsonB // Canonical JSON payload of changes
  prevHash  String   @db.VarChar(64) // 64 zeroes for genesis, then the previous entry hash
  hash      String   @db.VarChar(64) // SHA-256 of the previous hash and canonical entry fields
  timestamp DateTime @default(now())

  // Restrict prevents ticket deletion from cascading into the append-only ledger.
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, seq])
  @@index([ticketId])
  @@map("audit_entries")
}

model Attachment {
  id         String     @id @default(uuid())
  ticketId   String
  fileName   String     @db.VarChar(255)
  storageKey String     @unique
  sha256Hash String     @db.VarChar(64)
  mimeType   String     @db.VarChar(128)
  fileSize   Int
  scanStatus ScanStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("attachments")
}

model SlaPolicy {
  id           String   @id @default(uuid())
  priority     Priority @unique
  tier         Int
  responseMins Int
  resolveMins  Int

  @@map("sla_policies")
}

model ClusterGroup {
  id            String    @id @default(uuid())
  label         String
  centroid      Unsupported("vector")?
  ticketCount   Int       @default(0)
  avgSentiment  Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tickets       Ticket[]

  @@map("cluster_groups")
}
