# Local development secrets. Replace every placeholder before starting services.
# Generate URL-safe values with: node -p "require('node:crypto').randomBytes(32).toString('base64url')"

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=vishanti_admin
POSTGRES_PASSWORD=replace_with_url_safe_admin_password
POSTGRES_DB=vishanti_ledger
APP_DB_PASSWORD=replace_with_a_different_url_safe_app_password
DATABASE_URL="postgresql://app_user:replace_with_a_different_url_safe_app_password@localhost:5432/vishanti_ledger?schema=public"
# Privileged connection used only for local Prisma migrations and schema administration.
DIRECT_URL="postgresql://vishanti_admin:replace_with_url_safe_admin_password@localhost:5432/vishanti_ledger?schema=public"

# Redis (BullMQ & Idempotency)
REDIS_URL="redis://localhost:6379"

# MinIO (S3 compatible direct uploads)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_url_safe_minio_password
MINIO_BUCKET_NAME="vishanti-attachments"

# API & Auth
PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET=replace_with_a_unique_32_byte_url_safe_secret
HMAC_SECRET=replace_with_a_different_32_byte_url_safe_secret

# Frontend Next.js Public
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
